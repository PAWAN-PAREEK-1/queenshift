{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/league/reset",
      "schedule": "0 0 1 */4 *"
    },
    {
      "path": "/api/user/cleanup-deleted",
      "schedule": "0 0 * * *"
    }
  ]
}
